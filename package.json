{
  "name": "RemusApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npm run android:qa",
    "android:qa": "react-native run-android --mode qaDebug --appId com.espindola.remus.app.qa",
    "android:prod": "react-native run-android --mode prodDebug --appId com.espindola.remus.app",
    "ios": "npm run ios:qa",
    "ios:qa": "react-native run-ios --scheme RemusAppQA --mode \"Debug QA\"",
    "ios:prod": "react-native run-ios --scheme RemusApp --mode Debug",
    "lint": "eslint .",
    "verify": "npm test -- --runInBand && tsc --noEmit && npm run lint -- --max-warnings=0",
    "start": "react-native start",
    "test": "jest",
    "firebase:verify": "python3 scripts/verify_firebase_configs.py"
  },
  "dependencies": {
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@react-native/new-app-screen": "0.88.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
